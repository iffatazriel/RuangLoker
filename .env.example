DATABASE_URL=file:./data/ruangloker.db

# Kunci enkripsi brankas berkas (AES-256-GCM). Wajib di produksi, minimal 32 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Jangan pernah commit nilai asli. Kalau kunci ini hilang, berkas lama tidak bisa dibuka.
VAULT_SECRET=

# Lokasi penyimpanan berkas terenkripsi (di luar folder publik).
VAULT_DIR=./data/vault
