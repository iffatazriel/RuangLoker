DATABASE_URL=file:./data/ruangloker.db

# Kunci enkripsi brankas berkas (AES-256-GCM). Wajib di produksi, minimal 32 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Jangan pernah commit nilai asli. Kalau kunci ini hilang, berkas lama tidak bisa dibuka.
VAULT_SECRET=

# Lokasi penyimpanan berkas terenkripsi (di luar folder publik).
VAULT_DIR=./data/vault

# Email akun yang boleh membuka panel kurasi dan konfirmasi pembayaran (dipisah koma).
ADMIN_EMAILS=

# Info pembayaran manual yang ditampilkan ke pengguna. Kosongkan yang tidak dipakai.
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
# URL gambar QRIS statis (mis. /qris.png di folder public).
PAYMENT_QRIS_URL=

# URL publik aplikasi, dipakai untuk tautan di email (mis. https://ruangloker.id). Wajib di produksi.
APP_URL=

# Email layanan via Resend (https://resend.com). Kosong = email hanya dicetak ke log server.
# MAIL_FROM harus memakai domain yang sudah diverifikasi di Resend.
RESEND_API_KEY=
MAIL_FROM="RuangLoker <noreply@ruangloker.id>"

# Email kontak yang ditampilkan di Kebijakan Privasi dan Syarat Layanan.
CONTACT_EMAIL=

# Isi 1 kalau aplikasi berjalan di belakang reverse proxy (Nginx/Caddy) agar batas percobaan memakai IP asli.
TRUST_PROXY=

# Cadangan: folder tujuan dan jumlah cadangan yang disimpan (npm run db:backup).
BACKUP_DIR=./backups
BACKUP_KEEP=14
