---
import AppLayout from '../layouts/AppLayout.astro';
import { getAccountOverview, formatBytes, hasSensitiveConsent } from '../db/account';
import { countActiveJobs } from '../db/queries';

const user = Astro.locals.user!;
const overview = await getAccountOverview(user.id);
const sensitive = await hasSensitiveConsent(user.id);
const totalJobs = await countActiveJobs();

const missingLabels: Record<string, string> = {
  fullName: 'nama lengkap',
  phone: 'nomor WhatsApp',
  city: 'kota domisili',
  lastEducation: 'pendidikan terakhir',
  lastExperience: 'pengalaman terakhir',
  skills: 'keahlian',
  desiredRoles: 'posisi yang dicari',
};

const nextSteps = [
  overview.completeness.percent < 100 && {
    href: '/profil',
    title: 'Lengkapi profil',
    body: `Masih kurang: ${overview.completeness.missing.map((m) => missingLabels[m] ?? m).join(', ')}.`,
  },
  !sensitive && {
    href: '/brankas',
    title: 'Aktifkan izin dokumen sensitif',
    body: 'Diperlukan sebelum bisa mengunggah KTP, ijazah, atau transkrip. Terenkripsi dan bisa dicabut.',
  },
  overview.fileCount === 0 && {
    href: '/brankas',
    title: 'Unggah CV pertama',
    body: 'Satu kali unggah, dipakai untuk semua lamaran berikutnya.',
  },
].filter(Boolean) as { href: string; title: string; body: string }[];
---

<AppLayout title="Ringkasan" active="ringkasan" userName={user.displayName}>
  <div class="mt-3">
    <h1 class="m-0 text-[24px] font-extrabold tracking-tight">Halo, {user.displayName.split(' ')[0]}</h1>
    <p class="m-0 mt-1 text-[13px] text-muted">
      {overview.completeness.percent === 100
        ? 'Profilmu lengkap. Tinggal pilih lowongan dan kirim.'
        : 'Selesaikan dua-tiga hal berikut, lalu kamu bisa mulai melamar.'}
    </p>
  </div>

  <div class="mt-3 grid gap-3 sm:grid-cols-3">
    <div class="card p-4">
      <p class="label-mono m-0">Kelengkapan profil</p>
      <p class="m-0 mt-1 text-[26px] leading-none font-extrabold">{overview.completeness.percent}%</p>
      <div class="mt-2 h-2 overflow-hidden rounded-full bg-surface-3">
        <div class="h-full bg-ink" style={`width:${overview.completeness.percent}%`}></div>
      </div>
    </div>

    <div class="card p-4">
      <p class="label-mono m-0">Berkas di brankas</p>
      <p class="m-0 mt-1 text-[26px] leading-none font-extrabold">{overview.fileCount}</p>
      <p class="m-0 mt-1.5 text-[11.5px] text-muted">{formatBytes(overview.bytesUsed)} terpakai</p>
    </div>

    <div class="card p-4">
      <p class="label-mono m-0">Lowongan aktif</p>
      <p class="m-0 mt-1 text-[26px] leading-none font-extrabold">{totalJobs}</p>
      <a href="/lowongan" class="mt-1.5 inline-block text-[11.5px] text-ink underline">Cari lowongan →</a>
    </div>
  </div>

  {nextSteps.length > 0 && (
    <section class="mt-4">
      <h2 class="m-0 text-[15px] font-bold">Langkah berikutnya</h2>
      <div class="mt-2 flex flex-col gap-2">
        {nextSteps.map((step) => (
          <a
            href={step.href}
            class="card flex flex-wrap items-center gap-3 p-4 text-ink no-underline transition-shadow hover:shadow-md"
          >
            <div class="min-w-0 flex-1">
              <p class="m-0 text-[13.5px] font-bold">{step.title}</p>
              <p class="m-0 mt-0.5 text-[12px] text-muted">{step.body}</p>
            </div>
            <span class="btn btn-ghost btn-sm">Buka</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mt-4">
    <div class="card p-5">
      <p class="label-mono m-0">Yang belum ada di versi ini</p>
      <p class="m-0 mt-2 text-[12.5px] leading-relaxed text-ink-2">
        Antrean kirim lamaran, CV kreatif, dan pembayaran belum dibangun. Yang sudah ada: akun,
        persetujuan UU PDP, profil, brankas berkas terenkripsi, serta CV ATS dengan Skor CV berbasis aturan.
      </p>
      <p class="m-0 mt-2 text-[12.5px] leading-relaxed text-muted">
        Karena belum ada fitur yang mengirim lamaran, berkasmu belum pernah keluar dari server ini.
      </p>
    </div>
  </section>
</AppLayout>
