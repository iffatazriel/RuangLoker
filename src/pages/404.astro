---
import Base from '../layouts/Base.astro';
---

<Base title="Halaman tidak ditemukan — RuangLoker" noindex>
  <section class="mx-auto max-w-xl px-4 py-20 text-center">
    <p class="label-mono m-0">404</p>
    <h1 class="m-0 mt-2 text-[28px] font-extrabold tracking-tight">Lowongan itu tidak ada di sini</h1>
    <p class="m-0 mt-2 text-[13.5px] leading-relaxed text-muted">
      Mungkin sudah diturunkan kurator karena kedaluwarsa, ditolak, atau tautannya salah ketik.
      Kami lebih memilih menampilkan halaman kosong daripada lowongan yang tidak bisa diverifikasi.
    </p>
    <div class="mt-5 flex flex-wrap justify-center gap-2">
      <a href="/lowongan" class="btn">Cari lowongan lain</a>
      <a href="/" class="btn btn-ghost">Beranda</a>
    </div>
  </section>
</Base>
