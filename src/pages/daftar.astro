---
import Base from '../layouts/Base.astro';
---

<Base title="Daftar Gratis — RuangLoker" noindex>
  <section class="mx-auto max-w-md px-4 py-14">
    <div class="card p-6">
      <p class="label-mono m-0">Fase berikutnya</p>
      <h1 class="m-0 mt-1 text-[24px] font-extrabold tracking-tight">Daftar Gratis</h1>
      <p class="m-0 mt-2 text-[13px] leading-relaxed text-muted">
        Pendaftaran belum dibangun di slice ini. Formulirnya akan memisahkan persetujuan pemrosesan
        data pribadi dari persetujuan pemasaran, sesuai UU PDP — bukan satu centang untuk semuanya.
      </p>
      <div class="mt-4 flex gap-2">
        <a href="/lowongan" class="btn flex-1">Lihat lowongan</a>
        <a href="/" class="btn btn-ghost flex-1">Beranda</a>
      </div>
    </div>
  </section>
</Base>
