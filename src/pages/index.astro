---
import Base from '../layouts/Base.astro';
import JobCard from '../components/JobCard.astro';
import { findJobs, countActiveJobs, getFacets } from '../db/queries';

const [jobs, total, facets] = await Promise.all([findJobs({ limit: 3 }), countActiveJobs(), getFacets()]);

const accountDeleted = Astro.url.searchParams.get('akun-dihapus') === '1';
const lift = 'absolute rounded-2xl border border-line bg-white shadow-[0_18px_40px_rgb(15_23_18/0.09)]';
---

<Base title="RuangLoker — Profil Sekali Isi, Lamaran Rapi ke Banyak Lowongan">
  {accountDeleted && (
    <div class="mx-auto max-w-6xl px-4 pt-4">
      <p class="m-0 rounded-xl border border-line bg-surface-2 px-4 py-3 text-[13.5px] font-semibold" role="status">
        Akun dan seluruh berkasmu sudah dihapus permanen. Terima kasih sudah mencoba RuangLoker.
      </p>
    </div>
  )}

  <section class="bg-[radial-gradient(1200px_500px_at_85%_10%,var(--color-accent-soft),transparent_60%)]">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-10 pb-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:pt-20 lg:pb-20">
      <div>
        <p class="m-0 inline-flex items-center gap-1.5 rounded-[10px] border border-line bg-white px-3 py-1.5 text-[13px] font-semibold text-ink-2 shadow-[0_4px_12px_rgb(0_0_0/0.04)]">
          Pilot Jabodetabek · <span class="text-accent">{total} lowongan</span> terverifikasi
        </p>
        <h1 class="m-0 mt-5 text-[44px] leading-[1.06] font-light lg:text-[64px]">
          Isi profil sekali, <strong class="block font-extrabold">lamar dengan rapi.</strong>
        </h1>
        <p class="m-0 mt-5 max-w-[30em] text-[17px] leading-relaxed text-ink-2">
          Profil dan berkas cukup diisi sekali. Untuk tiap lowongan, RuangLoker menyiapkan subjek, isi surat,
          dan nama berkas CV. Kamu tinggal meninjau, lalu kirim dari email atau WhatsApp sendiri.
        </p>

        <form method="GET" action="/lowongan" class="mt-7 grid gap-2 rounded-2xl border border-line bg-white p-2 shadow-[0_8px_24px_rgb(15_23_18/0.05)] sm:grid-cols-[1fr_1fr_auto]">
          <input class="min-w-0 rounded-xl border-0 bg-surface-2 px-4 py-3 text-[15px] outline-none focus:ring-2 focus:ring-accent-soft sm:bg-transparent" type="search" name="q" placeholder="Posisi, mis. Admin" aria-label="Posisi yang dicari" />
          <input class="min-w-0 rounded-xl border-0 bg-surface-2 px-4 py-3 text-[15px] outline-none focus:ring-2 focus:ring-accent-soft sm:rounded-none sm:border-l sm:border-line sm:bg-transparent" type="search" name="kota" placeholder="Kota, mis. Depok" aria-label="Kota" />
          <button class="btn" type="submit">Cari lowongan</button>
        </form>
        <p class="m-0 mt-4 text-[13px] text-muted">Gratis 3 lamaran per bulan · tanpa kartu kredit</p>
      </div>

      <div class="relative grid gap-3 sm:block sm:h-[540px]" aria-label="Contoh lamaran yang disiapkan RuangLoker">
        <div class={`${lift} relative z-10 ml-3 flex items-center gap-3 justify-self-start p-3 pr-4 sm:absolute sm:left-0 sm:top-0 sm:ml-0`}>
          <svg width="54" height="54" viewBox="0 0 60 60" aria-hidden="true">
            <circle cx="30" cy="30" r="25" fill="none" stroke="var(--color-line-2)" stroke-width="6" />
            <circle cx="30" cy="30" r="25" fill="none" stroke="var(--color-accent)" stroke-width="6" stroke-linecap="round" stroke-dasharray="157.08" stroke-dashoffset="12.57" transform="rotate(-90 30 30)" />
            <text x="30" y="36" text-anchor="middle" font-size="17" font-weight="800" fill="currentColor">92</text>
          </svg>
          <div><p class="m-0 text-[11.5px] text-muted">Contoh skor CV ATS</p><p class="m-0 text-[13.5px] font-bold">Siap dikirim</p></div>
        </div>

        <div class={`${lift} relative -mt-7 p-5 pt-8 sm:absolute sm:inset-x-[4%] sm:left-[7%] sm:top-14 sm:mt-0 sm:pt-5`}>
          <div class="mb-2 flex items-center justify-between">
            <p class="m-0 text-[14px] font-bold">Lamaran disiapkan</p>
            <span class="pill pill-solid">Siap ditinjau</span>
          </div>
          <dl class="m-0 text-[13px]">
            <div class="grid grid-cols-[72px_1fr] gap-2 border-t border-line-2 py-2.5"><dt class="text-muted">Kepada</dt><dd class="m-0">rekrutmen@majubersama.co.id</dd></div>
            <div class="grid grid-cols-[72px_1fr] gap-2 border-t border-line-2 py-2.5"><dt class="text-muted">Subjek</dt><dd class="m-0 font-semibold">Lamaran Staff Admin — Budi Santoso</dd></div>
            <div class="hidden grid-cols-[72px_1fr] gap-2 border-t border-line-2 py-2.5 sm:grid"><dt class="text-muted">Isi</dt><dd class="m-0 text-muted">Yth. Tim Rekrutmen PT Maju Bersama, saya Budi Santoso, lulusan SMK Administrasi Perkantoran, ingin melamar posisi Staff Admin…</dd></div>
            <div class="grid grid-cols-[72px_1fr] gap-2 border-t border-line-2 py-2.5"><dt class="text-muted">Lampiran</dt><dd class="m-0"><span class="inline-flex items-center gap-2 rounded-lg bg-surface-2 px-2.5 py-1.5 text-[12.5px] font-semibold"><span class="rounded bg-[#e5484d] px-1 text-[10px] font-extrabold text-white">PDF</span>CV_Budi-Santoso_Staff-Admin.pdf</span></dd></div>
          </dl>
          <p class="m-0 mt-3 grid h-10 place-items-center rounded-[10px] bg-accent text-[13.5px] font-semibold text-white">Buka di aplikasi email</p>
        </div>

        <div class={`${lift} hidden w-[220px] p-3.5 sm:right-0 sm:top-0 sm:block`}>
          <div class="flex items-center gap-2.5">
            <span class="grid size-9 place-items-center rounded-[10px] bg-accent-soft text-[12px] font-extrabold text-accent-2">MB</span>
            <div><p class="m-0 text-[13.5px] font-bold">Staff Admin</p><p class="m-0 text-[11.5px] text-muted">PT Maju Bersama · Jakarta Selatan</p></div>
          </div>
          <p class="m-0 mt-2 border-t border-line-2 pt-2 text-[11px] text-muted">Sumber asli dan tanggal dicek selalu tercantum</p>
        </div>

        <div class={`${lift} relative z-10 mx-3 -mt-5 flex max-w-[290px] items-center gap-2.5 p-3.5 sm:absolute sm:bottom-0 sm:left-[2%] sm:mx-0 sm:mt-0`}>
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-[#25d366]" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z" /></svg>
          </span>
          <p class="m-0 text-[12.5px] leading-snug"><b class="block text-[13px]">Lamar via WhatsApp</b>Pesan disiapkan dengan link CV. Kamu yang menekan kirim.</p>
        </div>

        <div class={`${lift} hidden w-[200px] p-3.5 text-[12.5px] sm:right-[6%] sm:bottom-[18px] sm:block`}>
          <div class="flex justify-between"><span>Profil</span><b>100%</b></div>
          <div class="mt-2 h-[7px] overflow-hidden rounded-full bg-line-2"><div class="h-full w-full rounded-full bg-accent"></div></div>
          <p class="m-0 mt-2 text-[11.5px] text-muted">Dipakai ulang untuk semua lamaran</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-4">
    <p class="m-0 text-center text-[14px] text-muted">Semua lowongan dikurasi manual dari sumber publik, dengan sumber asli tercantum di tiap kartu.</p>
    <dl class="m-0 mt-6 grid grid-cols-2 gap-5 text-center md:grid-cols-4">
      <div><dt class="sr-only">Lowongan aktif</dt><dd class="m-0 text-[32px] font-extrabold tracking-tight">{total}</dd><p class="m-0 text-[13.5px] text-muted">lowongan aktif terverifikasi</p></div>
      <div><dt class="sr-only">Kategori</dt><dd class="m-0 text-[32px] font-extrabold tracking-tight">{facets.categories.length}</dd><p class="m-0 text-[13.5px] text-muted">kategori: {facets.categories.join(' dan ').toLowerCase()}</p></div>
      <div><dt class="sr-only">Kota</dt><dd class="m-0 text-[32px] font-extrabold tracking-tight">{facets.cities.length}</dd><p class="m-0 text-[13.5px] text-muted">kota di Jabodetabek</p></div>
      <div><dt class="sr-only">Poin skor CV</dt><dd class="m-0 text-[32px] font-extrabold tracking-tight">100</dd><p class="m-0 text-[13.5px] text-muted">poin aturan skor CV, terbuka</p></div>
    </dl>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-14 sm:pt-20 lg:pt-24">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 class="m-0 text-[32px] leading-tight font-bold lg:text-[40px]">Baru masuk <span class="font-light">kurasi.</span></h2>
      <a href="/lowongan" class="btn btn-ghost btn-sm">Lihat semua ({total})</a>
    </div>
    <div class="-mx-4 mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-2 md:mx-0 md:grid md:grid-cols-3 md:gap-4 md:overflow-visible md:px-0 md:pb-0">
      {jobs.map((job) => <div class="w-[82%] shrink-0 snap-start md:w-auto"><JobCard job={job} compact /></div>)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-14 sm:pt-20 lg:pt-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="m-0 text-[32px] leading-tight font-bold lg:text-[44px]">Satu ruang, <span class="font-light">semua lamaran.</span></h2>
      <p class="m-0 mt-3 text-[16.5px] leading-relaxed text-ink-2">Yang biasanya kamu ketik ulang di setiap lamaran, cukup disiapkan sekali.</p>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-6">
      <div class="card p-6 transition hover:-translate-y-0.5 hover:shadow-[0_16px_36px_rgb(15_23_18/0.07)] md:col-span-3">
        <span class="grid size-11 place-items-center rounded-xl bg-[#fff1e8]" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#e0662b" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg></span>
        <h3 class="m-0 mt-5 text-[19px] font-bold">Profil sekali isi</h3>
        <p class="col-start-2 m-0 mt-2 text-[14.5px] leading-relaxed text-ink-2">Nama, kontak, pendidikan, pengalaman, dan keahlian diisi sekali. Setiap CV dan surat lamaran mengambil dari sini.</p>
      </div>
      <div class="card p-6 transition hover:-translate-y-0.5 hover:shadow-[0_16px_36px_rgb(15_23_18/0.07)] md:col-span-3">
        <span class="grid size-11 place-items-center rounded-xl bg-accent-soft" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2" /></svg></span>
        <h3 class="m-0 mt-5 text-[19px] font-bold">Skor CV dengan aturan terbuka</h3>
        <p class="col-start-2 m-0 mt-2 text-[14.5px] leading-relaxed text-ink-2">Skor ini dihitung dari aturan yang kami tulis terbuka, bukan tebakan AI. Setiap saran menyebut poin yang hilang dan cara memperbaikinya.</p>
        <div class="mt-4 rounded-xl bg-surface-2 p-3.5 text-[13px]">
          <div class="flex justify-between gap-3"><span>Tulis ringkasan 2–3 kalimat</span><b class="text-accent">+10</b></div>
          <div class="mt-2 flex justify-between gap-3 border-t border-line pt-2"><span>Tambah angka di uraian tugas</span><b class="text-accent">+6</b></div>
        </div>
      </div>
      <div class="card grid grid-cols-[44px_1fr] gap-x-4 p-5 md:block md:p-6 md:col-span-2">
        <span class="row-span-2 grid size-11 shrink-0 place-items-center rounded-xl bg-[#eef2ff]" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b4fd8" stroke-width="2" stroke-linecap="round"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg></span>
        <h3 class="col-start-2 m-0 text-[17px] font-bold md:mt-5 md:text-[18px]">Brankas terenkripsi</h3>
        <p class="col-start-2 m-0 mt-2 text-[14.5px] leading-relaxed text-ink-2">CV, ijazah, dan KTP disimpan terenkripsi. Hapus akun, semua berkas ikut dimusnahkan.</p>
      </div>
      <div class="card grid grid-cols-[44px_1fr] gap-x-4 p-5 md:block md:p-6 md:col-span-2">
        <span class="row-span-2 grid size-11 shrink-0 place-items-center rounded-xl bg-[#fdf2f8]" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#c2417f" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg></span>
        <h3 class="col-start-2 m-0 text-[17px] font-bold md:mt-5 md:text-[18px]">Lowongan dengan sumber</h3>
        <p class="col-start-2 m-0 mt-2 text-[14.5px] leading-relaxed text-ink-2">Setiap kartu mencantumkan sumber asli dan tanggal terakhir dicek, jadi kamu bisa memastikan sendiri.</p>
      </div>
      <div class="card grid grid-cols-[44px_1fr] gap-x-4 p-5 md:block md:p-6 md:col-span-2">
        <span class="row-span-2 grid size-11 shrink-0 place-items-center rounded-xl bg-[#ecfdf3]" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1f9d55" stroke-width="2" stroke-linecap="round"><path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" /></svg></span>
        <h3 class="col-start-2 m-0 text-[17px] font-bold md:mt-5 md:text-[18px]">Kirim dari akunmu sendiri</h3>
        <p class="col-start-2 m-0 mt-2 text-[14.5px] leading-relaxed text-ink-2">Email dan WhatsApp tetap milikmu. Balasan HRD masuk langsung ke kamu, bukan ke kami.</p>
      </div>
    </div>
  </section>

  <section id="cara-kerja" class="mx-auto max-w-6xl scroll-mt-24 px-4 pt-14 sm:pt-20 lg:pt-24">
    <h2 class="m-0 text-center text-[32px] leading-tight font-bold lg:text-[44px]">Tiga langkah, <span class="font-light">tanpa mengetik ulang.</span></h2>
    <ol class="m-0 mt-10 grid list-none gap-4 p-0 md:grid-cols-3">
      {[
        ['Siapkan sekali', 'Isi profil, lalu unggah CV, ijazah, dan KTP ke brankas berkas.'],
        ['Pilih lowongan yang cocok', 'Filter kota atau jarak. Lihat jalur lamar dan sumber asli sebelum memutuskan.'],
        ['Tinjau, lalu kirim sendiri', 'Lewat email, CV kamu lampirkan sendiri. Lewat WhatsApp, kami sertakan link CV.'],
      ].map(([title, text], i) => (
        <li class="grid grid-cols-[36px_1fr] gap-x-4 rounded-[20px] bg-surface-2 p-5 md:block md:p-6">
          <span class="row-span-2 grid size-9 place-items-center rounded-[10px] border border-line bg-white text-[14px] font-extrabold text-accent">{i + 1}</span>
          <h3 class="col-start-2 m-0 text-[17px] font-bold md:mt-5 md:text-[18px]">{title}</h3>
          <p class="col-start-2 m-0 mt-2 text-[14.5px] leading-relaxed text-ink-2">{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="janji" class="mx-auto max-w-6xl scroll-mt-24 px-4 pt-14 sm:pt-20 lg:pt-24">
    <h2 class="m-0 text-center text-[32px] leading-tight font-bold lg:text-[44px]">Yang kami janjikan, <span class="font-light">dan yang tidak.</span></h2>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      <div class="rounded-[20px] bg-ink p-7 text-white">
        <h3 class="m-0 text-[18px] font-bold text-[#9cc8ff]">Kami janjikan</h3>
        <ul class="m-0 mt-4 grid list-none gap-3 p-0 text-[15px] leading-relaxed">
          {['Profil diisi sekali, tidak mengetik data yang sama dua kali.', 'Setiap lamaran rapi dan formatnya konsisten.', 'Setiap lowongan mencantumkan sumber asli dan tanggal pengecekan.'].map((t) => (
            <li class="relative pl-6"><span class="absolute left-0 top-[0.45em] size-3 rounded-[4px] bg-accent" aria-hidden="true"></span>{t}</li>
          ))}
        </ul>
      </div>
      <div class="rounded-[20px] border-[1.5px] border-dashed border-[#cfd5da] p-7">
        <h3 class="m-0 text-[18px] font-bold">Tidak kami janjikan</h3>
        <ul class="m-0 mt-4 grid list-none gap-3 p-0 text-[15px] leading-relaxed text-ink-2">
          {['Lamaran terkirim otomatis tanpa kamu menekan kirim.', 'CV terlampir otomatis di email atau WhatsApp.', 'Waktu per lamaran tertentu. Angka sebenarnya kami ukur, lalu kami laporkan.'].map((t) => (
            <li class="relative pl-6"><span class="absolute left-px top-[0.75em] h-0.5 w-[11px] bg-muted" aria-hidden="true"></span>{t}</li>
          ))}
        </ul>
      </div>
    </div>
    <p class="m-0 mt-4 text-[13.5px] text-muted">Pengiriman otomatis dengan lampiran hanya mungkin lewat koneksi Gmail resmi. Itu rencana fitur Pro, bukan bagian dari versi ini.</p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-14 sm:pt-20 lg:pt-24">
    <div class="grid gap-5 rounded-[28px] bg-accent px-7 py-12 text-white md:grid-cols-[1fr_auto] md:items-center md:p-16">
      <div>
        <h2 class="m-0 text-[32px] leading-tight font-bold lg:text-[44px]">Mulai dari profil.</h2>
        <p class="m-0 mt-2 text-[16px] text-white/85">Gratis 3 lamaran per bulan. Hapus akun dan semua berkas kapan saja.</p>
      </div>
      <a href="/daftar" class="btn border-white bg-white text-ink shadow-none hover:bg-white/90">Daftar gratis</a>
    </div>
  </section>
</Base>
