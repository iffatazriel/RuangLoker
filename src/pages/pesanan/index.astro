---
import AppLayout from '../../layouts/AppLayout.astro';
import { getProfile } from '../../db/account';
import { creditBalance, listOrders, paymentInfo } from '../../db/orders';
import { formatDate } from '../../lib/format';
import { formatRp, PRODUCTS, STATUS_LABELS, type OrderStatus, type ProductKey } from '../../lib/pricing';

const user = Astro.locals.user!;
const [profile, list, credits] = await Promise.all([getProfile(user.id), listOrders(user.id), creditBalance(user.id)]);
const pay = paymentInfo();
const hasPayInfo = !!(pay.accountNumber || pay.qrisUrl);
const newId = Number(Astro.url.searchParams.get('baru'));
const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const awaitingCheck = list.some((o) => o.status === 'menunggu' && o.claimedAt);
const okText: Record<string, string> = {
  klaim: 'Terima kasih. Admin akan mengecek pembayaranmu, biasanya di hari kerja yang sama.',
  batal: 'Pesanan dibatalkan.',
  gagal: 'Status pesanan sudah berubah. Muat ulang halaman.',
};
---

<AppLayout title="Pesanan" active="pesanan" userName={profile?.fullName || user.email}>
  <div class="mt-4 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="m-0 page-title">Pesanan</h1>
      <p class="m-0 mt-1 text-[13px] text-muted">Kredit lamaran: <b class="text-ink">{credits}</b></p>
    </div>
    <a href="/paket" class="btn btn-ghost">Lihat paket</a>
  </div>

  {ok && okText[ok] && (ok !== 'klaim' || awaitingCheck) && <p class="mt-3 rounded-xl border border-line bg-white px-4 py-2.5 text-[13px] font-semibold" role="status">{okText[ok]}</p>}
  {error === 'terbuka' && <p class="mt-3 rounded-xl border border-ink bg-white px-4 py-2.5 text-[13px] font-semibold" role="alert">Masih ada 3 pesanan menunggu pembayaran. Selesaikan atau batalkan dulu.</p>}

  {list.length === 0 ? (
    <p class="card m-0 mt-4 p-5 text-[13px] text-muted">Belum ada pesanan. Kuota Gratis 3 lamaran per bulan tetap bisa dipakai tanpa membayar.</p>
  ) : (
    <ul class="m-0 mt-4 grid list-none gap-3 p-0">
      {list.map((o) => {
        const p = PRODUCTS[o.product as ProductKey];
        return (
          <li class:list={['card p-5', o.id === newId && 'border-accent']}>
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <b class="block text-[15px]">{p?.name ?? o.product}</b>
                <span class="text-[12.5px] text-muted">{o.code} · {formatDate(o.createdAt)}</span>
              </div>
              <div class="text-right">
                <b class="block text-[16px]">{formatRp(o.amountRp)}</b>
                <span class:list={['pill', (o.status === 'dibayar' || o.status === 'selesai') && 'pill-solid']}>{STATUS_LABELS[o.status as OrderStatus] ?? o.status}</span>
              </div>
            </div>

            {o.status === 'menunggu' && (
              <div class="mt-4 grid gap-4 border-t border-line-2 pt-4 md:grid-cols-[1fr_auto]">
                <div class="text-[13px]">
                  <b>Cara bayar</b>
                  {hasPayInfo ? (
                    <ol class="m-0 mt-2 grid gap-1.5 pl-5">
                      <li>Transfer tepat <b>{formatRp(o.amountRp)}</b>{pay.accountNumber && <> ke {pay.bankName} <b class="font-mono">{pay.accountNumber}</b> a.n. {pay.accountName}</>}{pay.qrisUrl && <>{pay.accountNumber ? ' atau ' : ' lewat '}scan QRIS</>}.</li>
                      <li>Tulis <b class="font-mono">{o.code}</b> di berita/catatan transfer.</li>
                      <li>Tekan "Saya sudah bayar" di bawah.</li>
                    </ol>
                  ) : (
                    <p class="m-0 mt-2 text-muted">Info rekening dan QRIS belum diatur oleh admin. Pesanan tetap tercatat; jangan transfer dulu sampai info pembayaran muncul di sini.</p>
                  )}
                  {o.claimedAt ? (
                    <p class="m-0 mt-3 text-muted">Kamu menandai sudah bayar pada {formatDate(o.claimedAt)}. Menunggu dicek admin.</p>
                  ) : hasPayInfo && (
                    <form method="POST" action="/api/pesanan" class="mt-3 grid gap-2 sm:flex sm:items-center">
                      <input type="hidden" name="action" value="sudah-bayar" /><input type="hidden" name="orderId" value={o.id} />
                      <input name="note" class="field sm:flex-1" maxlength="300" placeholder="Nama pengirim / bank (opsional)" />
                      <button class="btn btn-sm" type="submit">Saya sudah bayar</button>
                    </form>
                  )}
                  <form method="POST" action="/api/pesanan" class="mt-2"><input type="hidden" name="action" value="batal" /><input type="hidden" name="orderId" value={o.id} /><button class="text-[12px] font-semibold text-muted underline" type="submit">Batalkan pesanan</button></form>
                </div>
                {pay.qrisUrl && <img src={pay.qrisUrl} alt="QRIS RuangLoker" class="w-44 rounded-xl border border-line" loading="lazy" />}
              </div>
            )}
            {o.status === 'dibayar' && <p class="m-0 mt-3 text-[13px] text-muted">Pembayaran dikonfirmasi {formatDate(o.paidAt)}. Tim kami sedang mengerjakan pesananmu dan akan menghubungi lewat {user.email}.</p>}
            {o.status === 'ditolak' && <p class="m-0 mt-3 text-[13px] text-muted">Pembayaran tidak ditemukan.{o.adminNote && ` Catatan admin: ${o.adminNote}`}</p>}
          </li>
        );
      })}
    </ul>
  )}
</AppLayout>
