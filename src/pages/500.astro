---
import Base from '../layouts/Base.astro';
---

<Base title="Terjadi kesalahan — RuangLoker" noindex>
  <section class="mx-auto max-w-xl px-4 py-20 text-center">
    <p class="label-mono m-0">500</p>
    <h1 class="m-0 mt-2 text-[28px] font-extrabold tracking-tight">Ada yang rusak di sisi kami</h1>
    <p class="m-0 mt-2 text-[13.5px] leading-relaxed text-muted">
      Datamu aman dan tidak ada lamaran yang terkirim. Coba muat ulang beberapa saat lagi. Kalau terus terjadi,
      kabari kami lewat formulir laporan.
    </p>
    <div class="mt-5 flex flex-wrap justify-center gap-2">
      <a href="/" class="btn">Beranda</a>
      <a href="/laporkan" class="btn btn-ghost">Laporkan masalah</a>
    </div>
  </section>
</Base>
