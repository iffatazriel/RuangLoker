---
import Base from '../layouts/Base.astro';
---

<Base title="Masuk — RuangLoker" noindex>
  <section class="mx-auto max-w-md px-4 py-14">
    <div class="card p-6">
      <p class="label-mono m-0">Fase berikutnya</p>
      <h1 class="m-0 mt-1 text-[24px] font-extrabold tracking-tight">Masuk</h1>
      <p class="m-0 mt-2 text-[13px] leading-relaxed text-muted">
        Autentikasi belum dibangun di slice ini. Slice yang sedang berjalan adalah lowongan publik
        dan panel kurasi — keduanya tidak memerlukan akun.
      </p>
      <p class="m-0 mt-3 text-[13px] leading-relaxed text-ink-2">
        Yang akan dibangun di slice berikutnya: daftar/masuk, <strong>consent UU PDP terpisah</strong>{' '}
        untuk KTP, profil sekali isi, dan brankas berkas terenkripsi.
      </p>
      <div class="mt-4 flex gap-2">
        <a href="/lowongan" class="btn flex-1">Lihat lowongan</a>
        <a href="/" class="btn btn-ghost flex-1">Beranda</a>
      </div>
    </div>
  </section>
</Base>
