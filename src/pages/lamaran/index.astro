---
import AppLayout from '../../layouts/AppLayout.astro';
import { getProfile } from '../../db/account';
import { listApplications, quotaState } from '../../db/applications';
import { CHANNEL_LABELS, formatDate } from '../../lib/format';

const user = Astro.locals.user!;
const [profile, apps, quota] = await Promise.all([getProfile(user.id), listApplications(user.id), quotaState(user.id)]);
const drafts = apps.filter((a) => a.status === 'draf');
const history = apps.filter((a) => a.status !== 'draf');
const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');
---

<AppLayout title="Lamaran" active="lamaran" userName={profile?.fullName || user.email}>
  <div class="mt-4 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="m-0 text-2xl font-extrabold tracking-tight">Lamaran</h1>
      <p class="m-0 mt-1 text-[13px] text-muted">Disiapkan di sini, dikirim dari email atau WhatsApp milikmu.</p>
    </div>
    <a href="/lowongan" class="btn">Cari lowongan</a>
  </div>

  <section class="card mt-4 p-4">
    <div class="flex items-center justify-between text-[13px]"><b>Kuota Gratis bulan ini</b><span>{quota.used} dari {quota.limit} terpakai</span></div>
    <div class="mt-2 h-2 overflow-hidden rounded-full bg-surface-3"><div class="h-full rounded-full bg-accent" style={`width:${Math.min(100, (quota.used / quota.limit) * 100)}%`}></div></div>
    <p class="m-0 mt-2 text-[12px] text-muted">Kuota terpakai saat lamaran disiapkan, dan direset tiap awal bulan (WIB). Setelah habis, kredit lamaran dipakai.</p>
    <div class="mt-3 flex items-center justify-between gap-2 border-t border-line-2 pt-3 text-[13px]"><span>Kredit lamaran: <b>{quota.credits}</b></span><a href="/paket" class="text-[12.5px] font-semibold text-accent">Beli kredit</a></div>
  </section>

  {error === 'kuota' && <p class="mt-3 rounded-xl border border-ink bg-white px-4 py-2.5 text-[13px] font-semibold" role="alert">Kuota Gratis bulan ini habis dan kredit lamaranmu 0. Lamaran yang sudah disiapkan tetap bisa dikirim. <a href="/paket" class="text-accent">Beli kredit Rp10.000 untuk 10 lamaran</a>.</p>}
  {ok === 'batal' && <p class="mt-3 rounded-xl border border-line bg-white px-4 py-2.5 text-[13px] font-semibold" role="status">Lamaran dibatalkan.</p>}

  <section class="mt-5">
    <h2 class="m-0 text-[15px] font-bold">Belum dikirim ({drafts.length})</h2>
    {drafts.length === 0 ? (
      <p class="card m-0 mt-2 p-4 text-[13px] text-muted">Belum ada. Buka lowongan, lalu tekan "Siapkan lamaran".</p>
    ) : (
      <ul class="m-0 mt-2 grid list-none gap-2 p-0">
        {drafts.map((a) => (
          <li><a href={`/lamaran/${a.id}`} class="card flex items-center gap-3 p-4 text-ink no-underline">
            <span class="min-w-0 flex-1"><b class="block text-[14px]">{a.jobTitle}</b><span class="text-[12.5px] text-muted">{a.company} · {CHANNEL_LABELS[a.channel] ?? a.channel}</span></span>
            <span class="btn btn-sm">Kirim</span>
          </a></li>
        ))}
      </ul>
    )}
  </section>

  <section class="mt-5">
    <h2 class="m-0 text-[15px] font-bold">Riwayat ({history.length})</h2>
    {history.length === 0 ? (
      <p class="card m-0 mt-2 p-4 text-[13px] text-muted">Lamaran yang sudah kamu tandai terkirim akan tercatat di sini.</p>
    ) : (
      <ul class="m-0 mt-2 grid list-none gap-2 p-0">
        {history.map((a) => (
          <li><a href={`/lamaran/${a.id}`} class="card flex items-center gap-3 p-4 text-ink no-underline">
            <span class="min-w-0 flex-1"><b class="block text-[14px]">{a.jobTitle}</b><span class="text-[12.5px] text-muted">{a.company} · {CHANNEL_LABELS[a.channel] ?? a.channel}</span></span>
            <span class:list={['pill', a.status === 'terkirim' && 'pill-solid']}>{a.status === 'terkirim' ? `Terkirim ${formatDate(a.sentAt)}` : 'Dibatalkan'}</span>
          </a></li>
        ))}
      </ul>
    )}
  </section>
</AppLayout>
