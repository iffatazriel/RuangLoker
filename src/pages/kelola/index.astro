---
import Base from '../../layouts/Base.astro';
import { getCurationQueue, getAllJobsForCuration } from '../../db/queries';
import { formatDate, relativeTime, salaryRange } from '../../lib/format';

const [queue, allJobs] = await Promise.all([getCurationQueue(), getAllJobsForCuration()]);
const okAction = Astro.url.searchParams.get('ok');

const actionLabel: Record<string, string> = {
  verify: 'Lowongan ditandai terverifikasi.',
  manual_check: 'Lowongan ditandai sudah dicek manual.',
  reject: 'Lowongan ditolak dan dinonaktifkan.',
  deactivate: 'Lowongan dinonaktifkan.',
  reactivate: 'Lowongan diaktifkan kembali.',
  extend: 'Masa tayang diperpanjang 30 hari.',
};

const statusLabel: Record<string, string> = {
  pending: 'Belum dicek',
  verified: 'Terverifikasi',
  manual_checked: 'Dicek manual',
  rejected: 'Ditolak',
};

---

<Base title="Panel Kurasi — RuangLoker" noindex>
  <section class="mx-auto max-w-6xl px-4 pt-6">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="label-mono m-0">Alat internal · tidak terindeks</p>
        <h1 class="m-0 mt-1 text-[26px] leading-tight font-extrabold tracking-tight">Panel Kurasi</h1>
        <p class="m-0 mt-1.5 max-w-2xl text-[13px] text-muted">
          Kurasi adalah produknya. Kalau antrean ini kosong setiap pagi, aliran lowongan berhenti —
          dan tidak ada harga yang menyelamatkan platform ini. Setiap keputusan di sini tercatat.
        </p>
      </div>
      <div class="flex gap-2"><a href="/kelola/pesanan" class="btn btn-sm">Pesanan &amp; pembayaran</a><a href="/lowongan" class="btn btn-ghost btn-sm">Lihat sisi publik</a></div>
    </div>

    {okAction && actionLabel[okAction] && (
      <p
        class="mt-4 rounded-xl border border-ink bg-surface-2 px-4 py-2.5 text-[13px] font-semibold"
        role="status"
      >
        {actionLabel[okAction]}
      </p>
    )}

    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <div class="card p-4">
        <p class="label-mono m-0">Perlu dicek</p>
        <p class="m-0 mt-1 text-[26px] leading-none font-extrabold">{queue.needingReview.length}</p>
        <p class="m-0 mt-1.5 text-[11.5px] text-muted">Belum lolos verifikasi, tidak tampil publik.</p>
      </div>
      <div class="card p-4">
        <p class="label-mono m-0">Berakhir 7 hari</p>
        <p class="m-0 mt-1 text-[26px] leading-none font-extrabold">{queue.expiringSoon.length}</p>
        <p class="m-0 mt-1.5 text-[11.5px] text-muted">Prioritas hari ini: verifikasi ulang atau turunkan.</p>
      </div>
      <div class="card p-4">
        <p class="label-mono m-0">Sudah kedaluwarsa</p>
        <p class="m-0 mt-1 text-[26px] leading-none font-extrabold">{queue.expired.length}</p>
        <p class="m-0 mt-1.5 text-[11.5px] text-muted">Otomatis tersembunyi dari pencarian publik.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-6">
    <h2 class="m-0 text-[16px] font-bold">Antrean hari ini</h2>

    {queue.needingReview.length === 0 && queue.expiringSoon.length === 0 ? (
      <div class="card mt-3 p-6 text-center">
        <p class="m-0 text-[14px] font-bold">Antrean kosong.</p>
        <p class="m-0 mt-1 text-[12.5px] text-muted">
          Tidak ada lowongan baru atau yang akan berakhir. Tambahkan sumber lowongan baru hari ini —
          aliran yang berhenti tiga hari mematikan retensi.
        </p>
      </div>
    ) : (
      <div class="mt-3 flex flex-col gap-2.5">
        {[...queue.needingReview, ...queue.expiringSoon].map((job) => (
          <article class="card p-4" data-curation-card>
            <div class="flex flex-wrap items-start gap-3">
              <div class="grid size-10 shrink-0 place-items-center rounded-xl bg-ink text-[11px] font-extrabold text-white" aria-hidden="true">
                {job.companyInitials}
              </div>

              <div class="min-w-0 flex-1">
                <h3 class="m-0 text-[15px] font-bold">{job.title}</h3>
                <p class="m-0 mt-0.5 text-[12.5px] text-muted">
                  {job.company} · {job.city} · {salaryRange(job.salaryMin, job.salaryMax)}
                </p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  <span class="pill">{statusLabel[job.verificationStatus] ?? job.verificationStatus}</span>
                  <span class="pill">Sumber: {job.sourceName}</span>
                  <span class="pill">Kanal: {job.applyChannel}</span>
                  <span class="pill">Batas: {formatDate(job.expiresAt)}</span>
                  <span class="pill">Dilihat {relativeTime(job.lastSeenAt)}</span>
                </div>
              </div>

              <a href={`/lowongan/${job.slug}`} class="btn btn-ghost btn-sm" target="_blank" rel="noopener">
                Pratinjau ↗
              </a>
            </div>

            <form method="POST" action="/api/kurasi" class="mt-3 flex flex-wrap items-center gap-2 border-t border-line-2 pt-3">
              <input type="hidden" name="jobId" value={job.id} />
              <input type="hidden" name="curator" value="kurator@pilot" />

              <input
                type="text"
                name="note"
                class="field flex-1 min-w-[200px]"
                placeholder="Catatan kurasi (opsional)…"
                aria-label="Catatan kurasi"
              />

              <button class="btn btn-sm" type="submit" name="action" value="verify">Verifikasi</button>
              <button class="btn btn-ghost btn-sm" type="submit" name="action" value="manual_check">
                Dicek manual
              </button>
              <button class="btn btn-ghost btn-sm" type="submit" name="action" value="extend">
                +30 hari
              </button>
              <button class="btn btn-ghost btn-sm" type="submit" name="action" value="reject">
                Tolak
              </button>
            </form>
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-8 pb-10">
    <div class="flex items-baseline justify-between gap-3">
      <h2 class="m-0 text-[16px] font-bold">Semua lowongan ({allJobs.length})</h2>
      <span class="label-mono">termasuk yang nonaktif</span>
    </div>

    <div class="card mt-3 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-[12.5px]">
          <thead>
            <tr class="border-b border-line bg-surface-2 text-left">
              <th class="px-3 py-2.5 font-bold">Posisi</th>
              <th class="px-3 py-2.5 font-bold">Kota</th>
              <th class="px-3 py-2.5 font-bold">Status</th>
              <th class="px-3 py-2.5 font-bold">Aktif</th>
              <th class="px-3 py-2.5 font-bold">Batas</th>
              <th class="px-3 py-2.5 font-bold">Aksi</th>
            </tr>
          </thead>
          <tbody>
            {allJobs.map((job) => (
              <tr class="border-b border-line-2 last:border-0">
                <td class="px-3 py-2.5">
                  <a href={`/lowongan/${job.slug}`} class="font-semibold text-ink underline-offset-2 hover:underline">
                    {job.title}
                  </a>
                  <span class="block text-[11px] text-muted">{job.company}</span>
                </td>
                <td class="px-3 py-2.5 text-muted">{job.city}</td>
                <td class="px-3 py-2.5">{statusLabel[job.verificationStatus] ?? job.verificationStatus}</td>
                <td class="px-3 py-2.5">{job.isActive ? 'Ya' : 'Tidak'}</td>
                <td class="px-3 py-2.5 text-muted">{formatDate(job.expiresAt)}</td>
                <td class="px-3 py-2.5">
                  <form method="POST" action="/api/kurasi" class="inline">
                    <input type="hidden" name="jobId" value={job.id} />
                    <input type="hidden" name="curator" value="kurator@pilot" />
                    <button
                      class="btn btn-ghost btn-sm"
                      type="submit"
                      name="action"
                      value={job.isActive ? 'deactivate' : 'reactivate'}
                    >
                      {job.isActive ? 'Nonaktifkan' : 'Aktifkan'}
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>
