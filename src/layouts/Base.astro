---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Profil sekali isi, lamaran rapi ke banyak lowongan terkurasi di Jabodetabek. CV dinilai sebelum berangkat.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

const currentUser = Astro.locals.user ?? null;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="id_ID" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
    >
      Lompat ke konten
    </a>

    <slot name="header">
      <header class="sticky top-0 z-50 border-b border-line-2 bg-white/85 backdrop-blur">
        <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:h-[72px]">
          <a href="/" class="flex items-center gap-2.5 no-underline">
            <span class="grid size-8 place-items-center rounded-[10px] bg-accent" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="3" stroke="#fff" stroke-width="2.4" /></svg>
            </span>
            <span class="text-[18px] font-bold tracking-tight text-ink">RuangLoker</span>
          </a>

          <nav class="mx-auto hidden items-center gap-7 text-[14.5px] font-medium text-ink-2 md:flex" aria-label="Menu utama">
            <a href="/lowongan" class="no-underline hover:text-ink">Lowongan</a>
            <a href="/#cara-kerja" class="no-underline hover:text-ink">Cara kerja</a>
            <a href="/#janji" class="no-underline hover:text-ink">Janji kami</a>
            <a href="/perusahaan" class="no-underline hover:text-ink">Untuk Perusahaan</a>
          </nav>

          <div class="ml-auto flex items-center gap-2 md:ml-0">
            <a href="/lowongan" class="px-2 text-[14px] font-medium text-ink-2 no-underline md:hidden">Lowongan</a>
            {currentUser ? (
              <a href="/app" class="btn btn-sm">Dashboard</a>
            ) : (
              <>
                <a href="/masuk" class="btn btn-ghost btn-sm hidden sm:inline-flex">Masuk</a>
                <a href="/daftar" class="btn btn-sm">Daftar gratis</a>
              </>
            )}
          </div>
        </div>
      </header>
    </slot>

    <main id="main">
      <slot />
    </main>

    <footer class="mx-auto max-w-6xl px-4 py-10 text-[12.5px] leading-relaxed text-muted">
      <div class="border-t border-line pt-6">
        <p class="m-0">
          <strong class="text-ink">RuangLoker</strong> — Satu Ruang, Semua Lamaran.
          Pilot Jabodetabek untuk kategori Admin &amp; Retail.
        </p>
        <p class="m-0 mt-1.5">
          Lowongan dikurasi manual dari sumber publik. Setiap kartu mencantumkan sumber asli dan
          tanggal pengecekan terakhir. Lamaran tetap dikirim dari email atau WhatsApp milik pelamar.
        </p>
        <p class="m-0 mt-1.5">
          Data contoh di lingkungan pengembangan. <a href="/lowongan" class="text-ink underline">Lihat lowongan</a> ·
          <a href="/kelola" class="text-ink underline">Panel kurasi</a>
        </p>
      </div>
    </footer>
  </body>
</html>
