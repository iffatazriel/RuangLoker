---
import Base from './Base.astro';

interface Props {
  title: string;
  active: 'ringkasan' | 'profil' | 'cv' | 'brankas' | 'akun';
  userName: string;
}

const { title, active, userName } = Astro.props;

const nav = [
  { key: 'ringkasan', href: '/app', label: 'Ringkasan' },
  { key: 'profil', href: '/profil', label: 'Profil' },
  { key: 'cv', href: '/cv', label: 'CV' },
  { key: 'brankas', href: '/brankas', label: 'Brankas' },
  { key: 'akun', href: '/akun', label: 'Akun' },
] as const;

const initials = userName
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? '')
  .join('');
---

<Base title={`${title} — RuangLoker`} noindex>
  <section class="mx-auto max-w-5xl px-4 pt-6">
    <div class="card flex items-center gap-2 px-2 py-2 sm:gap-3 sm:px-4 sm:py-3">
      <nav class="-mx-1 flex min-w-0 flex-1 gap-1 overflow-x-auto px-1 text-[13px] font-semibold" aria-label="Menu akun">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'shrink-0 rounded-full px-3 py-1.5 no-underline',
              item.key === active ? 'bg-ink text-white' : 'text-muted hover:bg-surface-2 hover:text-ink',
            ]}
            aria-current={item.key === active ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex shrink-0 items-center gap-2">
        <span
          title={userName}
          class="hidden size-8 place-items-center sm:grid rounded-full bg-ink text-[11px] font-extrabold text-white"
          aria-hidden="true">{initials || 'U'}</span
        >
        <span class="hidden text-[12px] font-semibold md:inline">{userName}</span>
        <form method="POST" action="/api/keluar">
          <button class="btn btn-ghost btn-sm" type="submit">Keluar</button>
        </form>
      </div>
    </div>

    <slot />
  </section>
</Base>
