---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  updated: string;
}
const { title, updated } = Astro.props;
---

<Base title={`${title} — RuangLoker`}>
  <article class="legal mx-auto max-w-3xl px-4 pt-8 sm:pt-10 pb-14 text-[14px] leading-relaxed text-ink-2">
    <h1 class="m-0 page-title text-ink">{title}</h1>
    <p class="m-0 mt-1.5 text-[12.5px] text-muted">Berlaku sejak {updated}</p>
    <slot />
  </article>
</Base>

<style>
  .legal :global(h2) { margin: 2rem 0 0.5rem; font-size: 17px; font-weight: 800; color: var(--color-ink); }
  .legal :global(p) { margin: 0.6rem 0 0; }
  .legal :global(ul) { margin: 0.6rem 0 0; padding-left: 1.2rem; }
  .legal :global(li) { margin-top: 0.3rem; }
  .legal :global(a) { color: var(--color-ink); text-decoration: underline; }
</style>
