---
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" class={className} aria-hidden="true">
  <rect width="64" height="64" rx="16" fill="var(--color-accent)" />
  <rect x="26" y="12" width="22" height="29" rx="4" fill="#fff" fill-opacity=".42" />
  <rect x="21" y="17" width="22" height="29" rx="4" fill="#fff" fill-opacity=".7" />
  <rect x="16" y="22" width="22" height="30" rx="4" fill="#fff" />
  <path d="M21 31h12M21 37h12M21 43h7" stroke="var(--color-accent)" stroke-width="2.8" stroke-linecap="round" />
</svg>
